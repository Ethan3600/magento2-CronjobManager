<?xml version="1.0"?>
<ruleset name="ethanyehuda/magento2-cronjobmanager">
    <description>Magento 2 coding standard.</description>
    <file>.</file>
    <arg name="extensions" value="php,phtml"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/Test/*/_files/*</exclude-pattern>
    <rule ref="Magento2">
        <!-- Moving InstallData/UpgradeData scripts to patches is a data migration, not a coding-standard fix. -->
        <exclude name="Magento2.Legacy.InstallUpgrade"/>
    </rule>
</ruleset>
